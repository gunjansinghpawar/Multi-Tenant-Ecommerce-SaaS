# ==========================================
# CommerceX Environment Configuration Template
# ==========================================

# Node Environment
NODE_ENV=development

# Database Configuration (PostgreSQL / Supabase)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/commercex?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/commercex?schema=public"

# App Public URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SUPER_ADMIN_URL="http://localhost:3001"
NEXT_PUBLIC_ADMIN_URL="http://localhost:3002"
NEXT_PUBLIC_STOREFRONT_URL="http://localhost:3000"

# Authentication (Better-Auth)
BETTER_AUTH_SECRET="development_secret_change_in_production_min_32_chars"
BETTER_AUTH_URL="http://localhost:3000"

# Storage (Supabase)
SUPABASE_URL="https://your-supabase-project.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Logging & Telemetry
LOG_LEVEL="info"
SENTRY_DSN=""

# Email (Resend / SMTP)
RESEND_API_KEY=""
EMAIL_FROM="noreply@commercex.local"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM_EMAIL="noreply@commercex.local"

# SMS (Twilio)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# WhatsApp (Meta)
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
