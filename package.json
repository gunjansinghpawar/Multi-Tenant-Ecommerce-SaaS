{
  "name": "commercex",
  "private": true,
  "version": "0.1.0",
  "description": "CommerceX Enterprise Multi-Tenant Ecommerce SaaS Platform",
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/builder/*"
  ],
  "packageManager": "npm@11.17.0",
  "scripts": {
    "build": "turbo run build",
