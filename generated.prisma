// ============================================================
// MASTER DATA MANAGEMENT MODULE
// ============================================================
model Continent {
  id String @id @default(uuid())
  tenantId String? // Added for safety but scope is GLOBAL
  code String @unique
  name String
  slug String @unique
  description String?
  sortOrder Int? @default(0)
  status String @default("ACTIVE")
  metadata Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  countries Country[]
}

model Country {
  id String @id @default(uuid())
  tenantId String? // Added for safety but scope is GLOBAL
  continentId String
  iso2 String @unique
  iso3 String @unique
  numericCode Int @unique
  name String
  officialName String?
  nativeName String?
  slug String @unique
  phoneCode String?
  currencyId String?
  capital String?
  latitude Float?
  longitude Float?
  flag String?
  sortOrder Int? @default(0)
  status String @default("ACTIVE")
  metadata Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  continent Continent? @relation(fields: [continentId], references: [id])
  currency Currency? @relation(fields: [currencyId], references: [id])
  states State[]
  cities City[]
}

model State {
  id String @id @default(uuid())
